<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.repository.mapper.UserMapper">

    <!-- ユーザー数をカウント -->
    <select id="count" resultType="integer">
        SELECT count(*) FROM `user`
    </select>

    <!-- 全ユーザーを取得 -->
    <select id="findAll" resultMap="UserListResult">
        SELECT
            id,
            mail,
            password,
            roles,
            created,
            last_logined,
            enabled
        FROM `user`
        ORDER BY id
    </select>

    <!-- ID でユーザーを取得 -->
    <select id="findById" parameterType="int" resultMap="UserListResult">
        SELECT
            id,
            mail,
            password,
            roles,
            created,
            last_logined,
            enabled
        FROM `user`
        WHERE id = #{id}
    </select>

    <!-- ユーザーを挿入 -->
    <insert id="insert" parameterType="com.example.demo.model.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `user` (mail, password, roles, created, last_logined, enabled)
        VALUES (#{mail}, #{password}, #{roles}, #{created}, NOW(), #{enabled})
    </insert>

    <!-- ユーザーを更新 -->
    <update id="update" parameterType="com.example.demo.model.User">
        UPDATE `user`
        SET 
            mail = #{mail}, 
            password = #{password}, 
            roles = #{roles}, 
            created = #{created}, 
            last_logined = #{lastLogined}, 
            enabled = #{enabled}
        WHERE id = #{id}
    </update>

    <!-- 結果マッピング -->
    <resultMap id="UserListResult" type="com.example.demo.model.User">
        <id property="id" column="id"/>
        <result property="mail" column="mail"/>
        <result property="password" column="password"/>
        <result property="roles" column="roles"/>
        <result property="created" column="created"/>
        <result property="lastLogined" column="last_logined"/>
        <result property="enabled" column="enabled"/>
    </resultMap>

</mapper>
